<?php
if (!empty($show_v2_notice)) {
?>
<div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i> <?php $this->_('Coingate.warning_v2_auth_token');?></div>
<?php
}
?>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Coingate.auth_token', true), 'auth_token', ['class' => 'form-label']);
    $this->Form->fieldText('auth_token', (isset($meta['auth_token']) ? $meta['auth_token'] : null), ['id' => 'auth_token', 'class' => 'form-control']);
    // Preserve the legacy API v1 credentials
    foreach (['app_id', 'api_key', 'api_secret'] as $legacy_field) {
        if (isset($meta[$legacy_field])) {
            $this->Form->fieldHidden($legacy_field, $meta[$legacy_field]);
        }
    }
    ?>
</div>
<div class="mb-3">
    <label for="receive_currency" class="form-label">
        <?php $this->_('Coingate.receive_currency'); ?>
        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
           title="<?php echo $this->Html->safe($this->_('Coingate.receive_currency_note', true)); ?>"></i>
    </label>
    <?php
    $this->Form->fieldSelect('receive_currency', (isset($receive_currency) ? $receive_currency : []), (isset($meta['receive_currency']) ? $meta['receive_currency'] : null), ['id' => 'receive_currency', 'class' => 'form-select']);
    ?>
</div>
<div class="mb-3">
    <label for="coingate_environment" class="form-label">
        <?php $this->_('Coingate.coingate_environment'); ?>
        <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
           title="<?php echo $this->Html->safe($this->_('Coingate.environment_note', true)); ?>"></i>
    </label>
    <?php
    $this->Form->fieldSelect('coingate_environment', (isset($coingate_environment) ? $coingate_environment : []), (isset($meta['coingate_environment']) ? $meta['coingate_environment'] : null), ['id' => 'coingate_environment', 'class' => 'form-select']);
    ?>
</div>
